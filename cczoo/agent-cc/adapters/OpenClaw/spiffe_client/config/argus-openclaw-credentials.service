[Unit]
Description=OpenClaw SPIFFE client credential delivery
After=network.target

[Service]
Type=simple
User=root
Group=argus-openclaw
RuntimeDirectory=argus-openclaw
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStartPre=/bin/sh -c 'test "$(/opt/spire-1.15.3/bin/spire-agent -version 2>&1)" = 1.15.3'
ExecStart=/opt/argus-workload/bin/spiffe-client-credentials -config /etc/argus-openclaw/credentials.json
ExecStopPost=/opt/argus-workload/bin/spiffe-client-credentials -config /etc/argus-openclaw/credentials.json -clear
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
UMask=0027
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/argus-openclaw

[Install]
WantedBy=multi-user.target
