FROM golang:1.24-bookworm AS build

WORKDIR /src
COPY adapters/OpenClaw/egress_sidecar/go.mod adapters/OpenClaw/egress_sidecar/go.sum ./
RUN go mod download
COPY adapters/OpenClaw/egress_sidecar/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -mod=readonly -trimpath -ldflags="-s -w" -o /out/openclaw-egress-sidecar ./cmd/egress-sidecar

FROM scratch
LABEL org.opencontainers.image.title="Argus OpenClaw SPIFFE Egress Broker"
LABEL argus.component="openclaw-broker"
USER 1000:1000
COPY --from=build /out/openclaw-egress-sidecar /openclaw-egress-sidecar
ENTRYPOINT ["/openclaw-egress-sidecar"]
