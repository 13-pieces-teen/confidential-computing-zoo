FROM rust:1.88-bookworm AS builder

ARG HTTPS_PROXY
ARG HTTP_PROXY
ARG NO_PROXY
ENV HTTPS_PROXY=$HTTPS_PROXY HTTP_PROXY=$HTTP_PROXY NO_PROXY=$NO_PROXY

WORKDIR /workspace
COPY argus/ ./argus/
COPY tdx-quote/ ./tdx-quote/
RUN cargo build --release --manifest-path ./argus/Cargo.toml --bin argus-guard

FROM debian:bookworm-slim
ARG HTTPS_PROXY
ARG HTTP_PROXY
ARG NO_PROXY
ENV HTTPS_PROXY=$HTTPS_PROXY HTTP_PROXY=$HTTP_PROXY NO_PROXY=$NO_PROXY
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=builder /workspace/argus/target/release/argus-guard /usr/local/bin/argus-guard
USER 65532:65532
ENTRYPOINT ["/usr/local/bin/argus-guard"]
