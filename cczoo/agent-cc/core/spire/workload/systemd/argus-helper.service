[Unit]
Description=Argus SPIFFE Helper Broker for OpenViking
Requires=argus-workload-agent.service argus-authz.service
BindsTo=argus-authz.service
After=argus-workload-agent.service argus-authz.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
UMask=0077
RuntimeDirectory=@RUN_NAME@-credentials
RuntimeDirectoryMode=0700
ExecStartPre=@BIN@/argus-workload -action check -registration @TARGET@
ExecStart=@BIN@/spiffe-helper -config @ETC@/helper.conf
ExecStopPost=@BIN@/nginx-hook.sh stop
ExecStopPost=@BIN@/nginx-hook.sh clear
Restart=on-failure
RestartSec=5s
TimeoutStopSec=5s
KillMode=control-group

[Install]
WantedBy=multi-user.target
