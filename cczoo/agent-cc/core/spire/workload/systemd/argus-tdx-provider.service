[Unit]
Description=Guest-local real TDX Node and Workload Evidence Provider
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
RuntimeDirectory=@RUN_NAME@
RuntimeDirectoryMode=0700
ExecStart=@BIN@/argus-spire-evidence-provider --agent-id @AGENT_ID@ --socket-path @PROVIDER_SOCKET@ --workload-registration-path @TARGET@ --workload-data-path @DATA_PATH@
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
KillMode=control-group
