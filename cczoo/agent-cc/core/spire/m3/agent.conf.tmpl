agent {
    data_dir = "/opt/spire/data/agent"
    log_level = "DEBUG"
    server_address = "spire-server"
    server_port = 8081
    socket_path = "/opt/spire/run/agent/agent.sock"
    trust_bundle_path = "/opt/spire/conf/certs/upstream-ca.pem"
    trust_domain = "argus.local"
}

telemetry {
    Prometheus {
        host = "0.0.0.0"
        port = 9989
    }
}

plugins {
    NodeAttestor "argus_tdx" {
        plugin_cmd = "/opt/spire/plugins/argus-tdx-nodeattestor-agent"
        plugin_checksum = "__AGENT_CHECKSUM__"
        plugin_data {
            evidence_endpoint = "http://127.0.0.1:18080/ra/v1/evidence"
            attestation_key_path = "/opt/spire/data/agent/argus-tdx/attestation-key"
            evidence_timeout = "10s"
            max_evidence_bytes = 4194304
            instance_hint = "tdvm-m3-0001"
        }
    }

    KeyManager "disk" {
        plugin_data {
            directory = "/opt/spire/data/agent"
        }
    }

    WorkloadAttestor "docker" {
        plugin_data {
            docker_socket_path = "unix:///var/run/docker.sock"
        }
    }

    WorkloadAttestor "unix" {
        plugin_data {}
    }
}
